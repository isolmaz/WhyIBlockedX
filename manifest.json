{
  "manifest_version": 3,
  "name": "WhyIBlockedX",
  "version": "0.5.1",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "127",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "WhyIBlockedX"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.x.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "src/content/observer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.x.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/i18n.js",
        "src/content/content.js",
        "src/content/actions.js",
        "src/content/profile.js"
      ],
      "run_at": "document_start"
    }
  ]
}
